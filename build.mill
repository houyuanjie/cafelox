//| mill-jvm-version: zulu:25
//| mill-version: 1.1.7
package build

import mill.*
import mill.scalalib.*

object CommonConfiguration:
  val jvmVersion           = "zulu:25"
  val scalaVersion         = "3.8.2"
  val scalaCompilerOptions = Seq(
    // format: off
    "-encoding", "UTF-8",
    "-release", "25",
    "-explain",
    "-explain-types",
    "-feature",
    "-deprecation",
    "-unchecked",
    "-Wsafe-init",
    "-Wunused:all",
    "-Wvalue-discard",
    "-Yexplicit-nulls",
    // format: on
  )

  object DependenceVersion:
    val munit = "1.3.4"

trait AnyScalaModule extends ScalaModule:
  override def jvmVersion    = Task(CommonConfiguration.jvmVersion)
  override def scalaVersion  = Task(CommonConfiguration.scalaVersion)
  override def scalacOptions = Task(CommonConfiguration.scalaCompilerOptions)

  object test extends ScalaTests with TestModule.Munit:
    override def munitVersion = Task(CommonConfiguration.DependenceVersion.munit)

object runtime extends AnyScalaModule

object compiler extends AnyScalaModule:
  override def moduleDeps = Seq(runtime)

object cli extends AnyScalaModule:
  override def moduleDeps = Seq(compiler)
