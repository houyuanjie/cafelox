//| mill-jvm-version: zulu:25
//| mill-version: 1.1.8
//| mvnDeps:
//|   - com.lihaoyi::mill-contrib-scoverage:$MILL_VERSION
//|   - com.goyeau::mill-scalafix::0.6.2
package build

import com.goyeau.mill.scalafix.ScalafixModule

import mill.*
import mill.api.*
import mill.contrib.scoverage.ScoverageModule
import mill.scalalib.*
import mill.scalalib.scalafmt.ScalafmtModule

import java.awt.Desktop

/** 公共配置 */
object CommonConfiguration:
  val jvmVersion           = "zulu:25"
  val scalaVersion         = "3.8.4"
  val scalaCompilerOptions = Seq(
    // format: off
    "-encoding", "UTF-8",
    "-release", "25",
    "-explain",
    "-explain-types",
    "-feature",
    "-deprecation",
    "-unchecked",
    "-Wsafe-init",
    "-Wunused:all",
    "-Wvalue-discard",
    "-Yexplicit-nulls",
    // format: on
  )

  object DependencyVersion:
    val munit     = "1.3.4"
    val scoverage = "2.5.2"

/** 扩展Task语法 */
extension [T](task: Task[T])
  /** 同步、按顺序执行一个子任务，丢弃返回值，失败时让外层命令失败 */
  inline def runOrFail(evaluator: Evaluator): Unit =
    evaluator
      .execute(Seq(task))
      .values
      .errorOpt
      .foreach(Task.fail)

/** Scala模块基础 */
trait AnyScalaModule extends ScalaModule with ScalafmtModule with ScoverageModule with ScalafixModule:
  override def jvmVersion       = Task(CommonConfiguration.jvmVersion)
  override def scalaVersion     = Task(CommonConfiguration.scalaVersion)
  override def scalacOptions    = Task(CommonConfiguration.scalaCompilerOptions)
  override def scoverageVersion = Task(CommonConfiguration.DependencyVersion.scoverage)

  /** 清洁并格式化代码 */
  def lintFmt(evaluator: Evaluator, args: String*): Task.Command[Unit] = Task.Command(exclusive = true):
    // 执行Scalafix
    this.fix(args*).runOrFail(evaluator)
    // 执行Scalafmt
    this.reformat().runOrFail(evaluator)

  /** 测试并报告覆盖率，返回报告数据文件夹 */
  def testCo(evaluator: Evaluator, args: String*): Task.Command[PathRef] = Task.Command(exclusive = true):
    // 执行默认测试任务
    assert(test.defaultTask() == "testForked")
    test.testForked(args*).runOrFail(evaluator)
    // 执行Scoverage报告任务
    this.scoverage.htmlReport().runOrFail(evaluator)
    // 获取报告文件
    val dataDir = this.scoverage.data().path
    assert(os.isDir(dataDir))
    val htmlReportDir = dataDir / os.up / "htmlReport.dest"
    assert(os.isDir(htmlReportDir))
    val indexHtml = htmlReportDir / "index.html"
    assert(os.isFile(indexHtml))
    // 如果支持，使用浏览器打开
    if Desktop.isDesktopSupported then Desktop.getDesktop.browse(indexHtml.toURI)
    // 返回报告数据
    PathRef(dataDir)

  object test extends ScoverageTests with TestModule.Munit:
    override def munitVersion = Task(CommonConfiguration.DependencyVersion.munit)

/** 运行时库 */
object runtime extends AnyScalaModule

/** 编译器 */
object compiler extends AnyScalaModule:
  override def moduleDeps = Seq(runtime)

/** 工具 */
object cli extends AnyScalaModule:
  override def moduleDeps = Seq(compiler)
